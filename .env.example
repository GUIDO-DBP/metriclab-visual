# Configurar en PowerShell: $env:METRICLAB_DATA = 'runtime/data'
# Python no carga este archivo automáticamente.
METRICLAB_DATA=runtime/data
# Opcional, mantiene HSV como predeterminado. Reiniciar tras modificar.
METRICLAB_ENABLE_RESNET=1
METRICLAB_RESNET_DEVICE=auto
# METRICLAB_RESNET_PYTHON=runtime/resnet-env/Scripts/python.exe
# METRICLAB_DESCRIPTOR_REGISTRY=runtime/descriptor_registry.json
# Solo necesario para el importador opcional. No se requiere para la aplicación.
DATABASE_URL=postgresql://usuario:clave@localhost:5432/metriclab
